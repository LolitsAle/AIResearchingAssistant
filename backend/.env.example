GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-1.5-flash
GOOGLE_EMBEDDING_MODEL=text-embedding-004
JWT_SECRET_KEY=your-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Do not add `pgbouncer=true` when using SQLAlchemy + psycopg2.
# If a copied URL contains `pgbouncer=true`, remove it and keep valid params such as `sslmode=require`.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REAL_REGION>.pooler.supabase.com:6543/postgres?sslmode=require
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./storage/uploads
